  ['<bdi>√10+√7</bdi>','<bdi>√10-√7</bdi>','<bdi>3(√10+√7)</bdi>','<bdi>√7-√10</bdi>'],0,
  'بالضرب في المرافق: 3(√10+√7)/(10-7) = 3(√10+√7)/3 = √10+√7');
add('الجذور التربيعية','بسّط: √√(15×15×15×15)', null,
