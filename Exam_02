add('الضرب الكبير','احسب ناتج ضرب: 3045 × 5872', null,
  ['<bdi>17880240</bdi>','<bdi>17860240</bdi>','<bdi>17680240</bdi>','<bdi>17980240</bdi>'],0,
  'بإجراء عملية الضرب الطويل: 3045×5872 = 17,880,240');

/* --- رقم الآحاد في القوى (2) --- */
add('رقم الآحاد في القوى','ما رقم آحاد العدد 7^2020؟', null,
  ['<bdi>1</bdi>','<bdi>7</bdi>','<bdi>9</bdi>','<bdi>3</bdi>'],0,
  'أرقام آحاد قوى 7 تتكرر كل 4 حدود: 7،9،3،1. بما أن 2020 يقبل القسمة على 4 بدون باقٍ، فرقم الآحاد هو الرقم الرابع في الدورة = 1');
add('رقم الآحاد في القوى','ما رقم آحاد العدد 4^2021؟', null,
  ['<bdi>4</bdi>','<bdi>6</bdi>','<bdi>2</bdi>','<bdi>8</bdi>'],0,
  'أرقام آحاد قوى 4 تتكرر كل حدين: 4،6. بما أن الأس 2021 فردي، فرقم الآحاد هو 4 (كما في 4^1)');
/* ============================= APP STATE ============================= */
const TOTAL_TIME = 70*60; // 70 minutes
let state = {
  screen:'landing', // landing | exam | results
  idx:0,
  timeLeft: TOTAL_TIME,
  timerHandle:null,
  navOpen:false,
  reviewMode:false
};

function fmtTime(s){
  const m = Math.floor(s/60), sec = s%60;
  return String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
}

function startExam(){
  state.screen='exam'; state.idx=0; state.timeLeft=TOTAL_TIME;
  Q.forEach(q=>{q.answer=null; q.flag=false;});
  clearInterval(state.timerHandle);
  state.timerHandle=setInterval(()=>{
    state.timeLeft--;
    if(state.timeLeft<=0){ state.timeLeft=0; clearInterval(state.timerHandle); submitExam(); }
    renderTimerOnly();
  },1000);
  render();
}

function selectOption(qIndex, optIndex){
  Q[qIndex].answer = optIndex;
  render();
}

function toggleFlag(qIndex){
  Q[qIndex].flag = !Q[qIndex].flag;
  render();
}

function goTo(i){
  if(i<0||i>=Q.length) return;
  state.idx=i; state.navOpen=false;
  render();
}

function submitExam(){
  clearInterval(state.timerHandle);
  state.screen='results'; state.reviewMode=false;
  render();
}

function confirmSubmit(){
  const unanswered = Q.filter(q=>q.answer===null).length;
  if(unanswered>0){
    if(!confirm(`لديك ${unanswered} سؤالاً لم تتم الإجابة عنه. هل تريد تسليم الاختبار الآن؟`)) return;
  }
  submitExam();
}

function retakeExam(){ startExam(); }

/* ============================= RENDER ============================= */
function render(){
  const app = document.getElementById('app');
  if(state.screen==='landing') app.innerHTML = renderLanding();
  else if(state.screen==='exam') app.innerHTML = renderExam();
  else app.innerHTML = renderResults();
  window.scrollTo(0,0);
}
function renderTimerOnly(){
  const el = document.getElementById('timerBox');
  if(!el) return;
  el.textContent = fmtTime(state.timeLeft);
  el.parentElement.classList.toggle('low', state.timeLeft<=120);
}

function brandbarHtml(){
  return `<div class="brandbar">
    <div class="brandmark"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg></div>
    <div class="brandtext">
      <div class="name">المدربة أم هشام</div>
      <div class="tag">العمليات الحسابية (الجزء الأول)</div>
    </div>
  </div>`;
}

function renderLanding(){
  return `
  ${brandbarHtml()}
  <div class="landing-card">
    <div class="eyebrow">تدريب القدرات — الكمي</div>
    <div class="landing-title">اختبار العمليات الحسابية (الجزء الأول)</div>
    <p class="landing-sub">اختبار إلكتروني تفاعلي يغطي العمليات على الكسور العشرية والاعتيادية، ترتيب العمليات، القيمة المكانية، الأسس والجذور، وخواص الأعداد — بإشراف المدربة أم هشام.</p>
    <div class="stat-row">
      <div class="stat"><div class="num">${Q.length}</div><div class="lbl2">سؤالاً</div></div>
      <div class="stat"><div class="num">70</div><div class="lbl2">دقيقة</div></div>
      <div class="stat"><div class="num">اختيار من متعدد</div><div class="lbl2">نوع الأسئلة</div></div>
    </div>
    <div class="rules">
      <div><b>قبل البدء:</b></div>
      <div>• يمكنك التنقّل بين الأسئلة بحرية والعودة لأي سؤال قبل التسليم.</div>
      <div>• استخدم أيقونة العلم لوضع علامة على سؤال ترغب بمراجعته لاحقاً.</div>
      <div>• سيُسلَّم الاختبار تلقائياً عند انتهاء الوقت.</div>
      <div>• بعد التسليم ستظهر نتيجتك التفصيلية مع مراجعة كامل الحل.</div>
    </div>
    <button class="btn btn-primary" onclick="startExam()">ابدأ الاختبار الآن</button>
  </div>`;
}

function renderExam(){
  const q = Q[state.idx];
  const answered = Q.filter(x=>x.answer!==null).length;
  const pct = Math.round(((state.idx+1)/Q.length)*100);
  const optionsHtml = q.options.map((o,i)=>`
    <div class="opt ${q.answer===i?'selected':''}" onclick="selectOption(${state.idx},${i})">
      <div class="letter">${['أ','ب','ج','د'][i]}</div>
      <div class="otext">${o}</div>
    </div>`).join('');

  const navcells = Q.map((x,i)=>`
    <div class="navcell ${x.answer!==null?'answered':''} ${i===state.idx?'current':''} ${x.flag?'flagged':''}"
      onclick="goTo(${i})">${i+1}</div>`).join('');

  return `
  ${brandbarHtml()}
  <div class="exambar">
    <div class="qcount">سؤال ${state.idx+1} <small>/ ${Q.length}</small></div>
    <div class="timer"><span id="timerBox">${fmtTime(state.timeLeft)}</span></div>
    <div style="display:flex;gap:8px;">
      <div class="iconbtn ${q.flag?'flagged':''}" onclick="toggleFlag(${state.idx})" title="وضع علامة">
        <svg viewBox="0 0 24 24"><path d="M5 3v18M5 4h11l-3 4 3 4H5"/></svg>
      </div>
      <div class="iconbtn" onclick="state.navOpen=!state.navOpen; render();" title="خريطة الأسئلة">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </div>
    </div>
  </div>
  <div class="progress-outer"><div class="progress-inner" style="width:${pct}%"></div></div>

  <div class="navgrid ${state.navOpen?'open':''}">
    <h3>خريطة الأسئلة</h3>
    <div class="navlegend">
      <span><span class="legdot" style="background:var(--ok-pale);border:1px solid var(--ok);"></span> تمت الإجابة</span>
      <span><span class="legdot" style="background:#fff;border:1px solid var(--line);"></span> بدون إجابة</span>
      <span><span class="legdot" style="background:var(--gold);"></span> معلَّم للمراجعة</span>
    </div>
    <div class="navwrap">${navcells}</div>
  </div>

  <div class="qcard">
    <div class="qmeta">
      <span class="qnum-badge">السؤال ${state.idx+1}</span>
      <span class="qcat">${q.cat}</span>
    </div>
    <div class="qtext">${q.text}</div>
    ${q.diagram? q.diagram : ''}
    <div class="options">${optionsHtml}</div>
  </div>

  <div class="navbtns">
    <button class="btn btn-ghost" style="${state.idx===0?'opacity:.4;pointer-events:none;':''}" onclick="goTo(${state.idx-1})" ${state.idx===0?'disabled':''}>السابق</button>
    ${state.idx===Q.length-1
      ? `<button class="btn btn-danger" onclick="confirmSubmit()">تسليم الاختبار</button>`
      : `<button class="btn btn-primary" onclick="goTo(${state.idx+1})">التالي</button>`}
  </div>
  <div style="text-align:center;color:var(--ink-soft);font-size:12.5px;margin-top:10px;">تمت الإجابة عن ${answered} من ${Q.length} سؤالاً</div>
  `;
}

function renderResults(){
  let correct=0, wrong=0, unanswered=0;
  Q.forEach(q=>{
    if(q.answer===null) unanswered++;
    else if(q.answer===q.correct) correct++;
    else wrong++;
  });
  const pct = Math.round((correct/Q.length)*100);

  if(!state.reviewMode){
    return `
    ${brandbarHtml()}
    <div class="score-hero">
      <div class="brand-small">المدربة أم هشام — نتيجة الاختبار</div>
      <h2>اختبار العمليات الحسابية (الجزء الأول)</h2>
      <div class="score-circle">
        <div class="pct">${pct}%</div>
        <div class="of">${correct} من ${Q.length}</div>
      </div>
    </div>
    <div class="result-grid">
      <div class="rbox ok"><div class="n">${correct}</div><div class="l">إجابات صحيحة</div></div>
      <div class="rbox bad"><div class="n">${wrong}</div><div class="l">إجابات خاطئة</div></div>
      <div class="rbox na"><div class="n">${unanswered}</div><div class="l">بدون إجابة</div></div>
    </div>
    <div class="actionrow">
      <button class="btn btn-primary" onclick="state.reviewMode=true; render();">مراجعة الإجابات</button>
      <button class="btn btn-outline-danger" onclick="retakeExam()">إعادة الاختبار</button>
    </div>
    `;
  }

  const items = Q.map((q,i)=>{
    let tag='na', tagText='بدون إجابة';
    if(q.answer!==null){ if(q.answer===q.correct){tag='ok';tagText='إجابة صحيحة';} else {tag='bad';tagText='إجابة خاطئة';} }
    const userAns = q.answer!==null? q.options[q.answer]: '<span style="color:#999">لم تتم الإجابة</span>';
    const correctAns = q.options[q.correct];
    return `<div class="review-item">
      <div class="rtitle"><span class="qnum-badge" style="background:var(--ink-soft)">سؤال ${i+1}</span><span class="rtag ${tag}">${tagText}</span></div>
      <div class="rq">${q.text}</div>
      ${q.diagram? q.diagram:''}
      <div class="rline">إجابتك: <b>${userAns}</b></div>
      <div class="rline">الإجابة الصحيحة: <b>${correctAns}</b></div>
      <div class="explain show">${q.explain}</div>
    </div>`;
  }).join('');

  return `
  ${brandbarHtml()}
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
    <h2 style="margin:0;color:var(--teal-deep);font-size:19px;">مراجعة الحل الكاملة</h2>
    <button class="btn btn-ghost" onclick="state.reviewMode=false; render();">رجوع للنتيجة</button>
  </div>
  ${items}
  <div class="actionrow" style="margin-top:10px;">
    <button class="btn btn-outline-danger" onclick="retakeExam()">إعادة الاختبار</button>
  </div>
  `;
}

render();
</script>
</body>
</html>
