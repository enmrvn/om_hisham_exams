<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>العمليات الحسابية (الجزء الأول) | المدربة أم هشام</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#12302e;
    --ink-soft:#3b5957;
    --paper:#f6f4ee;
    --card:#ffffff;
    --teal:#0f6e64;
    --teal-deep:#0a4b44;
    --teal-pale:#e4f1ee;
    --gold:#c08a2e;
    --gold-pale:#faf1de;
    --line:#e1ddd0;
    --danger:#b3402f;
    --danger-pale:#fbe9e5;
    --ok:#227a52;
    --ok-pale:#e6f4ec;
    --warn:#c08a2e;
    --radius:14px;
    --shadow:0 4px 18px rgba(18,48,46,.08);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    font-family:'Tajawal','Cairo',sans-serif;
    color:var(--ink);
    min-height:100vh;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 34px 34px;
    background-position:center;
  }
  h1,h2,h3,.brand{font-family:'Cairo',sans-serif;}
  bdi{unicode-bidi:isolate;}
  .app{max-width:760px;margin:0 auto;min-height:100vh;padding:18px 16px 60px;}

  /* ---------- Brand header ---------- */
  .brandbar{
    display:flex;align-items:center;gap:12px;
    padding:10px 4px 18px;
  }
  .brandmark{
    width:46px;height:46px;border-radius:12px;
    background:linear-gradient(135deg,var(--teal),var(--teal-deep));
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .brandmark svg{width:26px;height:26px;stroke:#fff;fill:none;stroke-width:2;}
  .brandtext .name{font-weight:800;font-size:17px;color:var(--teal-deep);line-height:1.2;}
  .brandtext .tag{font-size:12.5px;color:var(--ink-soft);}

  /* ---------- Landing ---------- */
  .landing-card{
    background:var(--card);border:1px solid var(--line);border-radius:20px;
    padding:34px 26px;box-shadow:var(--shadow);text-align:center;
    position:relative;overflow:hidden;
  }
  .landing-card::before{
    content:"";position:absolute;inset:0 0 auto 0;height:6px;
    background:linear-gradient(90deg,var(--gold),var(--teal));
  }
  .eyebrow{color:var(--gold);font-weight:700;font-size:13px;letter-spacing:.3px;margin-bottom:6px;}
  .landing-title{font-size:26px;font-weight:900;color:var(--teal-deep);margin:2px 0 8px;}
  .landing-sub{color:var(--ink-soft);font-size:15px;line-height:1.9;max-width:480px;margin:0 auto 22px;}
  .stat-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:26px;}
  .stat{
    background:var(--teal-pale);border:1px solid #cfe6e1;border-radius:12px;
    padding:12px 18px;min-width:110px;
  }
  .stat .num{font-weight:900;font-size:22px;color:var(--teal-deep);}
  .stat .lbl2{font-size:12.5px;color:var(--ink-soft);margin-top:2px;}
  .rules{
    text-align:right;background:var(--gold-pale);border:1px solid #ecd9b0;
    border-radius:12px;padding:16px 18px;margin-bottom:26px;font-size:14px;color:#6b4d17;line-height:2;
  }
  .rules b{color:#563c10;}
  .btn{
    appearance:none;border:none;cursor:pointer;font-family:inherit;font-weight:700;
    border-radius:12px;padding:15px 28px;font-size:16px;transition:transform .12s ease, box-shadow .12s ease;
  }
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--teal);color:#fff;box-shadow:0 6px 16px rgba(15,110,100,.32);width:100%;}
  .btn-primary:hover{background:var(--teal-deep);}
  .btn-ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink);}
  .btn-danger{background:var(--danger);color:#fff;}
  .btn-outline-danger{background:#fff;border:1.5px solid var(--danger);color:var(--danger);}

  /* ---------- Exam header ---------- */
  .exambar{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    background:var(--card);border:1px solid var(--line);border-radius:16px;
    padding:12px 16px;margin-bottom:16px;box-shadow:var(--shadow);
    position:sticky;top:10px;z-index:5;
  }
  .qcount{font-weight:800;color:var(--teal-deep);font-size:15px;}
  .qcount small{color:var(--ink-soft);font-weight:500;}
  .timer{
    display:flex;align-items:center;gap:6px;font-weight:800;color:var(--teal-deep);
    background:var(--teal-pale);padding:7px 12px;border-radius:10px;font-size:15px;
  }
  .timer.low{background:var(--danger-pale);color:var(--danger);}
  .iconbtn{
    width:38px;height:38px;border-radius:10px;border:1.5px solid var(--line);background:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;
  }
  .iconbtn svg{width:18px;height:18px;stroke:var(--ink-soft);fill:none;stroke-width:2;}
  .iconbtn.flagged{background:var(--gold-pale);border-color:var(--gold);}
  .iconbtn.flagged svg{stroke:var(--gold);fill:var(--gold);}

  .progress-outer{height:6px;background:var(--line);border-radius:4px;overflow:hidden;margin-bottom:18px;}
  .progress-inner{height:100%;background:linear-gradient(90deg,var(--gold),var(--teal));transition:width .25s ease;}

  /* ---------- Nav grid ---------- */
  .navgrid{
    display:none;background:var(--card);border:1px solid var(--line);border-radius:16px;
    padding:16px;margin-bottom:16px;box-shadow:var(--shadow);
  }
  .navgrid.open{display:block;}
  .navgrid h3{margin:0 0 10px;font-size:14px;color:var(--teal-deep);}
  .navlegend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--ink-soft);margin-bottom:12px;}
  .legdot{display:inline-block;width:10px;height:10px;border-radius:3px;margin-inline-start:4px;vertical-align:middle;}
  .navwrap{display:grid;grid-template-columns:repeat(8,1fr);gap:7px;max-height:260px;overflow-y:auto;}
  .navcell{
    aspect-ratio:1;border-radius:8px;border:1.5px solid var(--line);background:#fff;
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;cursor:pointer;
    color:var(--ink-soft);position:relative;
  }
  .navcell.answered{background:var(--ok-pale);border-color:var(--ok);color:var(--ok);}
  .navcell.current{outline:2px solid var(--teal);outline-offset:1px;}
  .navcell.flagged::after{
    content:"";position:absolute;top:-3px;left:-3px;width:8px;height:8px;border-radius:50%;background:var(--gold);
  }

  /* ---------- Question card ---------- */
  .qcard{
    background:var(--card);border:1px solid var(--line);border-radius:18px;
    padding:22px 20px;box-shadow:var(--shadow);margin-bottom:16px;
  }
  .qmeta{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  .qnum-badge{
    background:var(--teal-deep);color:#fff;font-weight:800;font-size:13px;
    padding:4px 12px;border-radius:20px;
  }
  .qcat{font-size:12.5px;color:var(--gold);font-weight:700;}
  .qtext{font-size:17px;font-weight:700;line-height:1.9;color:var(--ink);margin:6px 0 16px;}
  .diagram{width:100%;max-width:280px;display:block;margin:6px auto 18px;}
  .diagram *{fill:none;stroke:#0f6e64;stroke-width:2;}
  .diagram text{fill:#12302e;stroke:none;font-size:13px;font-family:'Tajawal',sans-serif;font-weight:600;}
  .diagram .fillmark{fill:#e4f1ee;stroke:#0f6e64;}
  .diagram .accent{stroke:#c08a2e;stroke-dasharray:5,4;}
  .diagram .thin{stroke-width:1.4;}

  .options{display:flex;flex-direction:column;gap:10px;}
  .opt{
    display:flex;align-items:center;gap:12px;
    border:1.6px solid var(--line);border-radius:12px;padding:13px 15px;cursor:pointer;
    background:#fff;transition:border-color .12s ease, background .12s ease;
  }
  .opt:hover{border-color:#bcd9d4;}
  .opt .letter{
    width:30px;height:30px;border-radius:9px;background:var(--teal-pale);color:var(--teal-deep);
    font-weight:800;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .opt .otext{font-size:15.5px;font-weight:600;}
  .opt.selected{border-color:var(--teal);background:var(--teal-pale);}
  .opt.selected .letter{background:var(--teal);color:#fff;}

  .opt.correct{border-color:var(--ok);background:var(--ok-pale);}
  .opt.correct .letter{background:var(--ok);color:#fff;}
  .opt.wrong{border-color:var(--danger);background:var(--danger-pale);}
  .opt.wrong .letter{background:var(--danger);color:#fff;}

  .explain{
    margin-top:14px;background:var(--gold-pale);border-inline-start:4px solid var(--gold);
    border-radius:10px;padding:12px 14px;font-size:14px;color:#6b4d17;line-height:1.9;display:none;
  }
  .explain.show{display:block;}

  .navbtns{display:flex;gap:10px;margin-top:6px;}
  .navbtns .btn{flex:1;}

  /* ---------- Results ---------- */
  .score-hero{
    background:linear-gradient(135deg,var(--teal-deep),var(--teal));color:#fff;border-radius:20px;
    padding:32px 24px;text-align:center;box-shadow:var(--shadow);margin-bottom:18px;
  }
  .score-hero .brand-small{font-size:13px;opacity:.85;margin-bottom:4px;}
  .score-hero h2{font-size:20px;margin:0 0 14px;font-weight:800;}
  .score-circle{
    width:132px;height:132px;border-radius:50%;border:6px solid rgba(255,255,255,.25);
    display:flex;align-items:center;justify-content:center;flex-direction:column;margin:0 auto 12px;
  }
  .score-circle .pct{font-size:32px;font-weight:900;}
  .score-circle .of{font-size:12px;opacity:.85;}
  .result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:20px;}
  .rbox{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 8px;text-align:center;}
  .rbox .n{font-size:22px;font-weight:900;}
  .rbox .l{font-size:12px;color:var(--ink-soft);margin-top:2px;}
  .rbox.ok .n{color:var(--ok);}
  .rbox.bad .n{color:var(--danger);}
  .rbox.na .n{color:var(--ink-soft);}
  .actionrow{display:flex;gap:10px;margin-bottom:20px;}
  .actionrow .btn{flex:1;}

  .review-item{
    background:var(--card);border:1px solid var(--line);border-radius:14px;
    padding:16px 16px;margin-bottom:12px;
  }
  .review-item .rtitle{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
  .review-item .rtag{font-size:12px;font-weight:800;padding:3px 10px;border-radius:20px;}
  .rtag.ok{background:var(--ok-pale);color:var(--ok);}
  .rtag.bad{background:var(--danger-pale);color:var(--danger);}
  .rtag.na{background:#eee;color:#777;}
  .review-item .rq{font-weight:700;font-size:15px;margin-bottom:6px;line-height:1.8;}
  .review-item .rline{font-size:13.5px;color:var(--ink-soft);margin:3px 0;}
  .review-item .rline b{color:var(--ink);}

  .hidden{display:none !important;}
  ::-webkit-scrollbar{width:6px;}
  ::-webkit-scrollbar-thumb{background:#c9c3af;border-radius:3px;}
  @media(max-width:420px){
    .navwrap{grid-template-columns:repeat(6,1fr);}
    .result-grid{grid-template-columns:repeat(3,1fr);}
  }
</style>
</head>
<body>
<div class="app" id="app"></div>

<script>
/* ============================= SVG HELPERS ============================= */
function svgWrap(inner, vb){ return `<svg viewBox="${vb||'0 0 240 190'}" class="diagram">${inner}</svg>`; }
function L(x1,y1,x2,y2,cls=''){ return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" class="${cls}"/>`; }
function PG(pts,cls=''){ return `<polygon points="${pts}" class="${cls}"/>`; }
function PL(pts,cls=''){ return `<polyline points="${pts}" class="${cls}"/>`; }
function CI(cx,cy,r,cls=''){ return `<circle cx="${cx}" cy="${cy}" r="${r}" class="${cls}"/>`; }
function TX(x,y,s,cls=''){ return `<text x="${x}" y="${y}" text-anchor="middle" class="${cls}">${s}</text>`; }
function rightAngleMark(x,y,size,rot){
  // simple small square marker; rot in {0,90,180,270} to orient corner
  const s=size;
  if(rot===0) return `<polyline points="${x},${y-s} ${x+s},${y-s} ${x+s},${y}" class="thin"/>`;
  if(rot===90) return `<polyline points="${x-s},${y-s} ${x-s},${y} ${x},${y}" class="thin"/>`;
  if(rot===180) return `<polyline points="${x-s},${y} ${x-s},${y+s} ${x},${y+s}" class="thin"/>`;
  return `<polyline points="${x},${y+s} ${x+s},${y+s} ${x+s},${y}" class="thin"/>`;
}
function arc(cx,cy,r,a1,a2,cls=''){
  const p1x=cx+r*Math.cos(a1*Math.PI/180), p1y=cy-r*Math.sin(a1*Math.PI/180);
  const p2x=cx+r*Math.cos(a2*Math.PI/180), p2y=cy-r*Math.sin(a2*Math.PI/180);
  const large = Math.abs(a2-a1)>180?1:0;
  return `<path d="M ${p1x} ${p1y} A ${r} ${r} 0 ${large} 0 ${p2x} ${p2y}" class="${cls}"/>`;
}
function ray(cx,cy,len,angleDeg){
  const rad=angleDeg*Math.PI/180;
  return [cx+len*Math.cos(rad), cy-len*Math.sin(rad)];
}

/* ---- shape diagrams ---- */
function diaTriHeight(base,h){
  const inner = PG("20,150 220,150 120,25") +
    L(120,150,120,25,'accent') + rightAngleMark(120,150,9,0) +
    TX(120,168,base+' سم') + TX(150,90,h+' سم');
  return svgWrap(inner);
}
function diaRightTri(a,b){
  const inner = PG("30,150 30,30 210,150") + rightAngleMark(30,150,10,0) +
    TX(12,95,a+' سم') + TX(120,168,b+' سم');
  return svgWrap(inner);
}
function diaEquilateral(side){
  const inner = PG("120,25 20,150 220,150") +
    TX(60,90,'‏٫') + TX(120,168,side+' سم') +
    L(65,113,72,120,'thin') + L(155,113,148,120,'thin') + L(112,145,128,145,'thin');
  return svgWrap(inner);
}
function diaParallelogram(base,h){
  const inner = PG("50,150 220,150 190,30 20,30") +
    L(50,150,50,30,'accent') + rightAngleMark(50,145,8,90) +
    TX(135,168,base+' سم') + TX(30,95,h+' سم');
  return svgWrap(inner);
}
function diaSquare(side){
  const inner = PG("40,30 200,30 200,150 40,150") + TX(120,168,side+' سم');
  return svgWrap(inner);
}
function diaSquareDiagonal(d){
  const inner = PG("40,30 200,30 200,150 40,150") + L(40,30,200,150,'accent') + TX(140,80,d+' سم');
  return svgWrap(inner);
}
function diaRectangle(w,h){
  const inner = PG("30,45 210,45 210,145 30,145") + TX(120,163,w+' سم') + TX(14,98,h+' سم');
  return svgWrap(inner);
}
function diaRhombusH(base,h){
  const inner = PG("120,20 210,95 120,170 30,95") +
    L(120,170,120,95,'accent') + rightAngleMark(120,168,8,180) +
    TX(178,140,base+' سم') + TX(140,135,h+' سم');
  return svgWrap(inner);
}
function diaRhombusD(d1,d2){
  const inner = PG("120,20 210,95 120,170 30,95") +
    L(120,20,120,170,'accent') + L(30,95,210,95,'accent') +
    TX(140,55,d1+' سم') + TX(120,88,d2+' سم');
  return svgWrap(inner);
}
function diaTrapezoid(top,bottom,h){
  const inner = PG("70,30 170,30 220,150 20,150") +
    L(70,30,70,150,'accent') + rightAngleMark(70,145,8,90) +
    TX(120,20,top+' سم') + TX(120,168,bottom+' سم') + TX(50,95,h+' سم');
  return svgWrap(inner);
}
function diaHexagon(side){
  const pts="90,25 150,25 190,95 150,165 90,165 50,95";
  return svgWrap(PG(pts) + TX(120,20,side+' سم'));
}
function diaCircleR(r){
  const inner = CI(120,95,60) + L(120,95,180,95,'accent') + TX(150,88,r+' سم');
  return svgWrap(inner);
}
function diaCircleD(d){
  const inner = CI(120,95,60) + L(60,95,180,95,'accent') + TX(120,85,d+' سم');
  return svgWrap(inner);
}
function diaStairs(w,h){
  const inner = PL("30,150 30,60 70,60 70,100 130,100 130,150",'') +
    TX(80,168,w+' سم') + TX(14,105,h+' سم');
  return svgWrap(inner);
}
function diaAngleRight(leg1,leg2,ang,findLabel){
  const inner = PG("30,150 30,30 210,150") + rightAngleMark(30,150,10,0) +
    arc(30,150,26,0,ang,'thin') + TX(58,138,ang+'°') +
    TX(14,95,leg1) + TX(120,168,findLabel);
  return svgWrap(inner);
}
function diaTree(hyp,base){
  const inner = L(30,150,30,45) + L(30,150,190,150) + L(30,45,190,150,'accent') +
    rightAngleMark(30,150,9,0) + TX(15,100,'؟') + TX(115,168,base+' م') + TX(120,90,hyp+' م');
  return svgWrap(inner);
}
function diaInscribedTri(r){
  const inner = CI(120,95,65) + PG("120,32 175,140 65,140") + L(120,95,120,32,'accent') + TX(140,65,r+' سم');
  return svgWrap(inner);
}
function diaInscribedSquare(diag){
  const inner = CI(120,95,60) + PG("120,35 180,95 120,155 60,95") + L(120,35,120,155,'accent') + TX(140,90,diag+' سم');
  return svgWrap(inner);
}
function diaCircleInSquare(side){
  const inner = PG("40,25 200,25 200,165 40,165") + CI(120,95,80) + TX(120,15,side+' سم');
  return svgWrap(inner);
}
function diaSquareInCircle(d){
  const inner = CI(120,95,85) + PG("120,10 205,95 120,180 35,95") + L(120,10,120,180,'accent') + TX(150,45,d+' سم');
  return svgWrap(inner);
}
function diaHexInCircle(r){
  const inner = CI(120,95,68) + PG("120,27 178,61 178,129 120,163 62,129 62,61") + L(120,95,120,27,'accent') + TX(140,62,r+' سم');
  return svgWrap(inner);
}
function diaTangentPoint(t1,t2){
  const inner = CI(150,110,45) + TX(50,60,'أ') + L(50,60,150,65,'') + L(50,60,150,155,'') +
    TX(105,55,t1+' سم') + (t2? TX(100,120,t2+' سم'):'');
  return svgWrap(inner);
}
function diaTangentTriangle(tan,r,findLabel){
  const inner = CI(160,130,40) + L(160,130,160,90,'accent') + L(160,90,60,50,'') + L(60,50,160,130,'accent') +
    rightAngleMark(160,90,8,90) + TX(180,110,r+' سم') + TX(95,60,tan+' سم') + TX(95,110,findLabel);
  return svgWrap(inner);
}
function diaLinearPair(given){
  const inner = L(20,110,220,110) + L(120,110,170,35,'accent') +
    arc(120,110,40,0,55,'thin') + TX(148,80,'س') + arc(120,110,55,55,180,'thin') + TX(72,90,given+'°');
  return svgWrap(inner,'0 0 240 150');
}
function diaThreeLine(a1,a2){
  const inner = L(20,110,220,110) + L(80,110,100,35,'accent') + L(160,110,180,35,'accent') +
    TX(66,80,a1+'°') + TX(190,80,a2+'°') + TX(128,80,'س');
  return svgWrap(inner,'0 0 240 150');
}
function diaComplementary(){
  const inner = L(30,150,30,30) + L(30,150,190,150) + L(30,150,140,60,'accent') +
    rightAngleMark(30,150,10,0) + TX(55,105,'س') + TX(105,130,'٢س');
  return svgWrap(inner);
}
function diaExterior(a1,a2){
  const inner = PG("40,150 130,40 220,150") + L(40,150,260,150) +
    TX(110,55,a1+'°') + TX(200,60,a2+'°') + TX(240,168,'س');
  return svgWrap(inner,'0 0 270 190');
}
function diaCentralInscribed(mode,given){
  const inner = CI(120,100,68) +
    (mode==='central'? (PG("120,100 178,60 178,140",'fillmark')+TX(140,100,given+'°')+PL("178,60 62,140 178,140",''))
      : (PL("178,60 62,140 178,140",'')+arc(178,100,20,140,220,'thin')+TX(160,100,given+'°')) ) +
    TX(120,180,'أوجد قيمة الزاوية المطلوبة');
  return svgWrap(inner,'0 0 240 200');
}
function diaSameArc(given){
  const inner = CI(120,100,68) + PL("60,70 180,70 120,150 60,70",'') + PL("60,70 120,150",'accent') +
    TX(70,60,given+'°') + TX(170,60,'س');
  return svgWrap(inner);
}
function diaCyclic(given){
  const inner = CI(120,100,68) + PG("70,50 175,80 165,150 60,130") +
    TX(90,65,given+'°') + TX(140,135,'س');
  return svgWrap(inner);
}
function diaXcross(given){
  const inner = L(30,30,210,170) + L(30,170,210,30) + arc(120,100,30,20,70,'thin') +
    TX(150,75,given+'°') + TX(160,120,'س') + TX(85,120,'ص');
  return svgWrap(inner);
}
function diaGrid(cols,rows){
  let inner='';
  const w=180,h=120,x0=30,y0=40,cw=w/cols,ch=h/rows;
  for(let i=0;i<=cols;i++) inner+=L(x0+i*cw,y0,x0+i*cw,y0+h);
  for(let j=0;j<=rows;j++) inner+=L(x0,y0+j*ch,x0+w,y0+j*ch);
  return svgWrap(inner);
}
function diaTriGrid(n){
  let inner='';
  const top=[120,20], bl=[30,160], br=[210,160];
  inner+=PG("120,20 30,160 210,160");
  for(let i=1;i<n;i++){
    const lx = top[0]+(bl[0]-top[0])*i/n, ly = top[1]+(bl[1]-top[1])*i/n;
    const rx = top[0]+(br[0]-top[0])*i/n, ry = top[1]+(br[1]-top[1])*i/n;
    inner+=L(lx,ly,rx,ry);
  }
  for(let i=1;i<n;i++){
    const bx = bl[0]+(br[0]-bl[0])*i/n, by=160;
    const tx1 = top[0]+(bl[0]-top[0])*(0)/n;
    inner+=L(bx,by, top[0]+(bx-bl[0])*0,20); // simplified vertical-ish guide (visual only)
  }
  return svgWrap(inner);
}

