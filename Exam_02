  '72×72×72×72 = 72⁴، وبأخذ الجذر التربيعي مرتين نحصل على 72');
add('الجذور التربيعية','بسّط: √√(4+4+4+4)', null,
  ['<bdi>2</bdi>','<bdi>4</bdi>','<bdi>16</bdi>','<bdi>√2</bdi>'],0,
  '4+4+4+4=16، والجذر التربيعي لـ16=4، ثم الجذر التربيعي لـ4=2');
add('الجذور التربيعية','بسّط: ∛(20×20×20)', null,
  ['<bdi>20</bdi>','<bdi>3</bdi>','<bdi>400</bdi>','<bdi>8000</bdi>'],0,
  '20×20×20=20³، والجذر التكعيبي لعدد مرفوع للأس 3 يعطي العدد نفسه = 20');
add('الجذور التربيعية','احسب ناتج: √(16/25) + √(9/25)', null,
  ['<bdi>1.4</bdi>','<bdi>1</bdi>','<bdi>1.2</bdi>','<bdi>7/25</bdi>'],0,
  '√(16/25)=4/5، √(9/25)=3/5، والمجموع = 4/5+3/5 = 7/5 = 1.4');
add('الجذور التربيعية','احسب ناتج: √50 + √32', null,
  ['<bdi>9√2</bdi>','<bdi>9√4</bdi>','<bdi>√82</bdi>','<bdi>13</bdi>'],0,
  '√50=5√2، √32=4√2، والمجموع = 5√2+4√2 = 9√2');
add('الجذور التربيعية','احسب ناتج: √48 - √27', null,
  ['<bdi>√3</bdi>','<bdi>√21</bdi>','<bdi>1</bdi>','<bdi>7√3</bdi>'],0,
  '√48=4√3، √27=3√3، والفرق = 4√3-3√3 = √3');
add('الجذور التربيعية','بسّط: √(3/48)', null,
  ['<bdi>0.25</bdi>','<bdi>0.5</bdi>','<bdi>4</bdi>','<bdi>1/12</bdi>'],0,
  '3/48 = 1/16، والجذر التربيعي لـ1/16 = 1/4 = 0.25');
add('الجذور التربيعية','بسّط: ∛(8/125)', null,
  ['<bdi>0.4</bdi>','<bdi>0.6</bdi>','<bdi>2.5</bdi>','<bdi>1.6</bdi>'],0,
  'الجذر التكعيبي لـ8=2، والجذر التكعيبي لـ125=5، فالناتج = 2/5 = 0.4');
add('الجذور التربيعية','بسّط: √(1/9) ÷ √(4/25)', null,
  ['<bdi>5/6</bdi>','<bdi>6/5</bdi>','<bdi>2/15</bdi>','<bdi>5/2</bdi>'],0,
  '√(1/9)=1/3، √(4/25)=2/5، والقسمة: (1/3)÷(2/5) = (1/3)×(5/2) = 5/6');

